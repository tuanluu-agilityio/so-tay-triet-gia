---
import Base from '../layouts/Base.astro';
import { trackFor } from '../lib/music.mjs';
import '../styles/home.css';
---
<Base title="Sổ Tay Triết Gia" description="Cây triết học từ Thales đến Foucault: 50 triết gia phương Tây, mỗi người một trang chi tiết dễ hiểu." track={trackFor()}>
<div class="home">
<header class="hero">
  <div class="eyebrow">Cây triết học</div>
  <h1>Sổ Tay <em>Triết Gia</em></h1>
  <p>Rễ cắm từ Hy Lạp cổ đại, cành vươn tới thế kỷ 20. Mỗi quả trên cây là một triết gia.</p>
</header>

<div class="scroller" id="scroller">
  <div class="tree grow" id="tree">
    <svg viewBox="0 0 1000 1300" preserveAspectRatio="none" aria-hidden="true">
      <defs><filter id="soft" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="22"/></filter></defs>
      <g class="canopy" id="canopy" filter="url(#soft)"></g>
      <path class="ground" d="M0 1062 Q500 1040 1000 1062 L1000 1078 Q500 1060 0 1078 Z"/>
      <g id="aerials"></g>
      <g id="roots"></g>
      <path class="trunk" d="M430 1070 C470 1020 478 900 482 760 C484 720 488 690 492 670 L508 670 C512 690 516 720 518 760 C522 900 530 1020 570 1070 Z"/>
      <g id="branches"></g>
    </svg>
    <canvas id="leaves" aria-hidden="true"></canvas>
    <div id="nodes"></div>
    <div class="tip" id="tip"><b></b><span></span></div>
  </div>
</div>
<p class="hint">Rê chuột hoặc chạm vào một gương mặt để xem tên, bấm để mở lớn. Trên điện thoại, vuốt ngang để xem cả cây.</p>

<div class="lb" id="lb" role="dialog" aria-modal="true" aria-labelledby="lbName" inert>
  <div class="lb-card">
    <span class="lb-pic" id="lbPic"></span>
    <h3 id="lbName"></h3>
    <p id="lbYears"></p>
    <div class="era-name" id="lbEra"></div>
    <div class="lb-actions"><a class="read" id="lbRead" href="socrates.html" hidden>Đọc bài viết</a><button type="button" id="lbClose">Đóng</button></div>
    <p class="soon" id="lbSoon">Bài viết về người này đang được soạn.</p>
  </div>
</div>

</div>
</Base>

<script is:inline>

const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
const NS = "http://www.w3.org/2000/svg", W = 1000, H = 1300;

// Mỗi thời kỳ là một phần của cây. kind: "roots" (rễ), "trunk" (thân), "branch" (nhánh — đường cong Bézier từ thân ra).
// Tọa độ trong khung 1000 × 1300. Năm âm là trước Công nguyên.
const ERAS = [
  { name: "Tiền Socrates", range: "Thế kỷ 7 – 5 TCN", kind: "roots", label: [500, 1272],
    people: [["Thales", -624, -546, "Thales of Miletus"], ["Anaximander", -610, -546, "Anaximander"],
      ["Pythagoras", -570, -495, "Pythagoras"], ["Heraclitus", -535, -475, "Heraclitus"],
      ["Parmenides", -515, -450, "Parmenides"], ["Zeno xứ Elea", -490, -430, "Zeno of Elea"],
      ["Democritus", -460, -370, "Democritus"]] },
  { name: "Hy Lạp cổ điển", range: "Thế kỷ 5 – 3 TCN", kind: "trunk", label: [700, 985],
    spots: [[500, 1005], [500, 925], [402, 965], [500, 845], [598, 885]],
    people: [["Socrates", -470, -399, "Socrates"], ["Plato", -428, -348, "Plato"], ["Diogenes", -412, -323, "Diogenes"],
      ["Aristotle", -384, -322, "Aristotle"], ["Epicurus", -341, -270, "Epicurus"]] },
  { name: "Hy Lạp hóa – La Mã", range: "TK 3 TCN – TK 3", kind: "branch", w: 15, label: [120, 860],
    curve: [[488, 800], [400, 790], [230, 760], [95, 735]],
    people: [["Zeno xứ Citium", -334, -262, "Zeno of Citium"], ["Seneca", -4, 65, "Seneca the Younger"],
      ["Epictetus", 50, 135, "Epictetus"], ["Marcus Aurelius", 121, 180, "Marcus Aurelius"], ["Plotinus", 204, 270, "Plotinus"]] },
  { name: "Trung cổ", range: "Thế kỷ 4 – 14", kind: "branch", w: 13, label: [870, 835],
    curve: [[512, 790], [600, 780], [760, 755], [880, 725]],
    people: [["Augustine", 354, 430, "Augustine of Hippo"], ["Anselm", 1033, 1109, "Anselm of Canterbury"],
      ["Thomas Aquinas", 1225, 1274, "Thomas Aquinas"], ["William xứ Ockham", 1287, 1347, "William of Ockham"]] },
  { name: "Phục hưng – Cận đại", range: "Thế kỷ 15 – 17", kind: "branch", w: 17, label: [92, 395],
    curve: [[490, 735], [400, 650], [180, 600], [70, 450]],
    people: [["Machiavelli", 1469, 1527, "Niccolò Machiavelli"], ["Montaigne", 1533, 1592, "Michel de Montaigne"],
      ["Francis Bacon", 1561, 1626, "Francis Bacon"], ["Thomas Hobbes", 1588, 1679, "Thomas Hobbes"],
      ["René Descartes", 1596, 1650, "René Descartes"], ["Blaise Pascal", 1623, 1662, "Blaise Pascal"],
      ["Baruch Spinoza", 1632, 1677, "Baruch Spinoza"], ["John Locke", 1632, 1704, "John Locke"],
      ["Gottfried Leibniz", 1646, 1716, "Gottfried Wilhelm Leibniz"]] },
  { name: "Khai sáng", range: "Thế kỷ 18", kind: "branch", w: 14, label: [905, 430],
    curve: [[510, 725], [620, 650], [830, 590], [910, 480]],
    people: [["George Berkeley", 1685, 1753, "George Berkeley"], ["Voltaire", 1694, 1778, "Voltaire"],
      ["David Hume", 1711, 1776, "David Hume"], ["Jean-Jacques Rousseau", 1712, 1778, "Jean-Jacques Rousseau"],
      ["Immanuel Kant", 1724, 1804, "Immanuel Kant"]] },
  { name: "Thế kỷ 19", range: "1800 – 1900", kind: "branch", w: 13, label: [235, 155],
    curve: [[494, 690], [470, 560], [330, 380], [270, 235]],
    people: [["Hegel", 1770, 1831, "Georg Wilhelm Friedrich Hegel"], ["Schopenhauer", 1788, 1860, "Arthur Schopenhauer"],
      ["John Stuart Mill", 1806, 1873, "John Stuart Mill"], ["Søren Kierkegaard", 1813, 1855, "Søren Kierkegaard"],
      ["Karl Marx", 1818, 1883, "Karl Marx"], ["Friedrich Nietzsche", 1844, 1900, "Friedrich Nietzsche"]] },
  { name: "Thế kỷ 20", range: "1900 – nay", kind: "branch", w: 14, label: [800, 75],
    curve: [[504, 680], [540, 520], [690, 330], [740, 130]],
    people: [["Bertrand Russell", 1872, 1970, "Bertrand Russell"], ["Ludwig Wittgenstein", 1889, 1951, "Ludwig Wittgenstein"],
      ["Martin Heidegger", 1889, 1976, "Martin Heidegger"], ["Karl Popper", 1902, 1994, "Karl Popper"],
      ["Jean-Paul Sartre", 1905, 1980, "Jean-Paul Sartre"], ["Hannah Arendt", 1906, 1975, "Hannah Arendt"],
      ["Simone de Beauvoir", 1908, 1986, "Simone de Beauvoir"], ["Albert Camus", 1913, 1960, "Albert Camus"],
      ["Michel Foucault", 1926, 1984, "Michel Foucault"]] },
];

// Triết gia đã có trang chi tiết
const SLUGS = ["thales","anaximander","pythagoras","heraclitus","parmenides","zeno-elea","democritus",
  "socrates","plato","diogenes","aristotle","epicurus","zeno-citium","seneca","epictetus","marcus-aurelius","plotinus",
  "augustine","anselm","aquinas","ockham","machiavelli","montaigne","bacon","hobbes","descartes","pascal","spinoza","locke","leibniz",
  "berkeley","voltaire","hume","rousseau","kant","hegel","schopenhauer","mill","kierkegaard","marx","nietzsche",
  "russell","wittgenstein","heidegger","popper","sartre","arendt","beauvoir","camus","foucault"];
const PAGES = {};
const fmt = y => y < 0 ? `${-y} TCN` : `${y}`;
const span = (b, d) => b < 0 && d > 0 ? `${fmt(b)} – ${d}` : (b < 0 ? `${-b} – ${-d} TCN` : `${b} – ${d}`);
const initial = n => { if (!/ xứ /.test(n)) n = n.split(" ").pop(); return n.normalize("NFD").replace(/[\u0300-\u036f]/g, "")[0]; };
const bez = ([a, b, c, d], t) => { const u = 1 - t;
  return [0, 1].map(i => u*u*u*a[i] + 3*u*u*t*b[i] + 3*u*t*t*c[i] + t*t*t*d[i]); };
const tan = ([a, b, c, d], t) => { const u = 1 - t;
  return [0, 1].map(i => 3*u*u*(b[i]-a[i]) + 6*u*t*(c[i]-b[i]) + 3*t*t*(d[i]-c[i])); };
const pathD = c => `M${c[0]} C${c[1]} ${c[2]} ${c[3]}`;
function svg(tag, attrs, parent) { const e = document.createElementNS(NS, tag); for (const k in attrs) e.setAttribute(k, attrs[k]); parent && parent.appendChild(e); return e; }
const pct = (x, y) => `left:${x / W * 100}%;top:${y / H * 100}%`;

const tree = document.getElementById("tree"), nodes = document.getElementById("nodes");
const gRoots = document.getElementById("roots"), gBr = document.getElementById("branches"), gAer = document.getElementById("aerials");
const all = [];
let order = 0; // thứ tự xuất hiện của các quả

// Thời điểm mọc của từng phần (giây)
const START = { roots: .1, trunk: 1.4 };
let branchT = 2.0;

ERAS.forEach((era, ei) => {
  const g = svg("g", { class: "era-g" }, era.kind === "roots" ? gRoots : gBr);
  era.g = g;
  let spots = [], t0;
  if (era.kind === "roots") {
    t0 = START.roots;
    const n = era.people.length;
    era.people.forEach((_, i) => {
      const x = 155 + i * 115, y = i % 2 ? 1212 : 1162;
      const c = [[500, 1066], [500 + (x - 500) * .15, 1110], [x, 1080], [x, y - 30]];
      svg("path", { d: pathD(c), class: "rt draw", "stroke-width": 9 - Math.abs(i - 3), pathLength: 1, style: `--t:${t0 + i * .06}s;--d:1.1s` }, g);
      // rễ con
      svg("path", { d: `M${x} ${y - 30} q ${i < 3 ? -30 : 30} 20 ${i < 3 ? -40 : 40} 60`, class: "rt draw", "stroke-width": 2, pathLength: 1, style: `--t:${t0 + .8}s;--d:.8s` }, g);
      spots.push([x, y, t0 + .9 + i * .08]);
    });
  } else if (era.kind === "trunk") {
    t0 = START.trunk;
    era.spots.forEach(([x, y], i) => {
      if (x !== 500) svg("line", { x1: 500, y1: y + 22, x2: x, y2: y, class: "twig draw", "stroke-width": 7, pathLength: 1, style: `--t:${t0 + .7}s;--d:.5s` }, g);
      spots.push([x, y, t0 + .8 + i * .1]);
    });
  } else {
    t0 = branchT; branchT += .45;
    const c = era.curve;
    svg("path", { d: pathD(c), class: "br draw", "stroke-width": era.w, pathLength: 1, style: `--t:${t0}s;--d:1.3s` }, g);
    // cành con ở cuối nhánh
    const end = c[3], tg = tan(c, 1), L = Math.hypot(...tg);
    [[.6, 50], [-.6, 42]].forEach(([rot, len]) => {
      const a = Math.atan2(tg[1], tg[0]) + rot;
      svg("path", { d: `M${end[0]} ${end[1]} l ${Math.cos(a) * len} ${Math.sin(a) * len}`, class: "br draw", "stroke-width": 4, pathLength: 1, style: `--t:${t0 + 1.1}s;--d:.5s` }, g);
    });
    const n = era.people.length;
    era.people.forEach((_, i) => {
      const t = .32 + .68 * (i + .5) / n;
      const [px, py] = bez(c, t), [tx, ty] = tan(c, t), l = Math.hypot(tx, ty);
      const side = i % 2 ? 1 : -1, off = 44;
      const x = px + (-ty / l) * off * side, y = py + (tx / l) * off * side;
      spots.push([x, y, t0 + .5 + t, px, py, g, t0 + .3 + t]);
    });
    // rễ phụ của cây đa buông xuống từ các nhánh thấp
    if (ei <= 5) for (let k = 0; k < 3; k++) {
      const t = .3 + k * .22, [x, y] = bez(c, t);
      const len = Math.min(1062 - y, 120 + ((ei * 37 + k * 53) % 160));
      svg("path", { d: `M${x} ${y + 6} c ${k % 2 ? 6 : -6} ${len * .35} ${k % 2 ? -6 : 6} ${len * .65} 0 ${len}`, class: "aerial draw", pathLength: 1, style: `--t:${t0 + 1.4 + k * .15}s;--d:1.6s` }, gAer);
    }
  }

  const lab = document.createElement("div");
  lab.className = "label"; lab.style.cssText = pct(...era.label) + `;--t:${(era.kind === "branch" ? t0 + 1.2 : t0 + 1)}s`;
  lab.innerHTML = `${era.name}<small>${era.range}</small>`;
  lab.addEventListener("pointerenter", () => focusEra(era)); lab.addEventListener("pointerleave", () => focusEra(null));
  nodes.appendChild(lab);

  era.spots = spots;
});

// Đẩy các quả chồng lên nhau ra xa (chỉ quả trên nhánh mới di chuyển), rồi vẽ cành con nối về nhánh
(() => {
  const pts = ERAS.flatMap(e => e.spots.map(s => ({ s, free: e.kind === "branch" })));
  const MIN = 74;
  for (let it = 0; it < 80; it++) for (let i = 0; i < pts.length; i++) for (let j = i + 1; j < pts.length; j++) {
    const a = pts[i].s, b = pts[j].s, dx = b[0] - a[0], dy = b[1] - a[1], d = Math.hypot(dx, dy) || 1;
    if (d >= MIN) continue;
    const push = (MIN - d) / 2, ux = dx / d, uy = dy / d;
    if (pts[i].free && pts[j].free) { a[0] -= ux * push; a[1] -= uy * push; b[0] += ux * push; b[1] += uy * push; }
    else if (pts[j].free) { b[0] += ux * push * 2; b[1] += uy * push * 2; }
    else if (pts[i].free) { a[0] -= ux * push * 2; a[1] -= uy * push * 2; }
  }
  pts.forEach(({ s: [x, y, , ax, ay, g, tt], free }) => {
    if (free) svg("line", { x1: ax, y1: ay, x2: x, y2: y, class: "twig draw", pathLength: 1, style: `--t:${tt}s;--d:.35s` }, g);
  });
})();

ERAS.forEach(era => {
  era.people.forEach(([name, born, died, wiki], i) => {
    const [x, y, t] = era.spots[i];
    const b = document.createElement("button");
    b.type = "button"; b.className = "face";
    b.style.cssText = pct(x, y) + `;--t:${t.toFixed(2)}s`;
    b.setAttribute("aria-label", `${name}, ${span(born, died)}, ${era.name}`);
    b.innerHTML = `<img alt="" decoding="async"><span class="mono" aria-hidden="true">${initial(name)}</span>`;
    const p = { name, born, died, wiki, era, el: b, img: b.querySelector("img"), x, y };
    p.img.addEventListener("load", () => p.img.classList.add("loaded"));
    b.addEventListener("pointerenter", () => showTip(p)); b.addEventListener("focus", () => showTip(p));
    b.addEventListener("pointerleave", hideTip); b.addEventListener("blur", hideTip);
    b.addEventListener("click", () => openLb(p));
    PAGES[name] = "/triet-gia/" + SLUGS[all.length] + "/";
    nodes.appendChild(b); all.push(p);
  });
});

// Tán lá: các đốm xanh mờ phía sau cành
(() => {
  const g = document.getElementById("canopy");
  const blobs = [[500, 430, 330], [260, 520, 230], [740, 480, 240], [180, 700, 170], [840, 690, 170], [330, 250, 190], [680, 220, 200], [500, 180, 170], [110, 470, 130], [900, 470, 130]];
  blobs.forEach(([cx, cy, r]) => svg("circle", { cx, cy, r }, g));
})();

// Làm nổi bật một thời kỳ
function focusEra(era) {
  tree.classList.toggle("focus", !!era);
  ERAS.forEach(e => e.g.classList.toggle("on", e === era));
  all.forEach(p => p.el.classList.toggle("on", p.era === era));
}
const tip = document.getElementById("tip");
function showTip(p) {
  tip.querySelector("b").textContent = p.name; tip.querySelector("span").textContent = span(p.born, p.died);
  tip.style.left = p.x / W * 100 + "%"; tip.style.top = (p.y - 34) / H * 100 + "%"; tip.classList.add("on");
  focusEra(p.era);
}
function hideTip() { tip.classList.remove("on"); focusEra(null); }

// Ảnh chân dung: ảnh đại diện có giấy phép tự do của từng bài Wikipedia (Wikimedia Commons), một lần gọi cho cả 50 người
const CACHE = "stgt-portraits-v1";
const applyPortraits = map => all.forEach(p => { const s = map[p.wiki]; if (s) { p.img.src = s; p.img.alt = "Chân dung " + p.name; } });
try { const c = JSON.parse(localStorage.getItem(CACHE) || "null"); if (c) applyPortraits(c); } catch (e) {}
(async () => {
  try {
    const url = "https://en.wikipedia.org/w/api.php?action=query&format=json&formatversion=2&origin=*&redirects=1" +
      "&prop=pageimages&piprop=thumbnail&pithumbsize=480&pilicense=free&titles=" + encodeURIComponent(all.map(p => p.wiki).join("|"));
    const data = await (await fetch(url)).json();
    const back = {};
    (data.query.normalized || []).forEach(n => back[n.to] = n.from);
    (data.query.redirects || []).forEach(r => back[r.to] = back[r.from] || r.from);
    const map = {};
    data.query.pages.forEach(pg => { if (pg.thumbnail) map[back[pg.title] || pg.title] = pg.thumbnail.source; });
    applyPortraits(map);
    try { localStorage.setItem(CACHE, JSON.stringify(map)); } catch (e) {}
  } catch (e) { /* không tải được ảnh: giữ chữ cái */ }
})();

// Cây mọc khi vào khung nhìn
if (reduce || !("IntersectionObserver" in window)) tree.classList.add("go");
else {
  const io = new IntersectionObserver(es => { if (es.some(e => e.isIntersecting)) { tree.classList.add("go"); io.disconnect(); } }, { threshold: .12 });
  io.observe(tree);
}
// Điện thoại: đưa khung cuộn ngang về giữa thân cây
const sc = document.getElementById("scroller");
sc.scrollLeft = (sc.scrollWidth - sc.clientWidth) / 2;

// Lá đa rơi nhẹ
(() => {
  if (reduce) return;
  const cv = document.getElementById("leaves"), ctx = cv.getContext("2d");
  let w, h, dpr; const leaves = [];
  function size() { dpr = Math.min(2, devicePixelRatio || 1); w = cv.clientWidth; h = cv.clientHeight; cv.width = w * dpr; cv.height = h * dpr; }
  size(); addEventListener("resize", size);
  const col = () => getComputedStyle(document.documentElement).getPropertyValue("--leaf").trim() || "#7fa36f";
  let color = col(); matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => color = col());
  function spawn(y) { leaves.push({ x: w * (.15 + Math.random() * .7), y: y ?? h * (.08 + Math.random() * .3), s: 6 + Math.random() * 7,
    vy: .25 + Math.random() * .35, ph: Math.random() * 6.28, r: Math.random() * 6.28, vr: (Math.random() - .5) * .03 }); }
  for (let i = 0; i < 9; i++) spawn(h * Math.random() * .8);
  function frame() {
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = color; ctx.globalAlpha = .55;
    for (let i = leaves.length - 1; i >= 0; i--) {
      const l = leaves[i]; l.ph += .02; l.y += l.vy; l.x += Math.sin(l.ph) * .6; l.r += l.vr;
      ctx.save(); ctx.translate(l.x, l.y); ctx.rotate(l.r + Math.sin(l.ph) * .4);
      // lá đa: hình tim thuôn, đuôi nhọn
      ctx.beginPath(); ctx.moveTo(0, -l.s);
      ctx.bezierCurveTo(l.s * .9, -l.s * 1.1, l.s * .9, l.s * .4, 0, l.s * 1.4);
      ctx.bezierCurveTo(-l.s * .9, l.s * .4, -l.s * .9, -l.s * 1.1, 0, -l.s); ctx.fill(); ctx.restore();
      if (l.y > h * .82) { leaves.splice(i, 1); spawn(); }
    }
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
})();

// Khung xem lớn
const lb = document.getElementById("lb"), lbPic = document.getElementById("lbPic");
let lastFocus = null;
function openLb(p) {
  lastFocus = p.el;
  lbPic.innerHTML = `<img alt="Chân dung ${p.name}"><span class="mono" aria-hidden="true">${initial(p.name)}</span>`;
  const im = lbPic.querySelector("img");
  im.onload = () => im.classList.add("loaded");
  if (p.img.src) { im.onerror = () => { im.onerror = null; im.src = p.img.src; }; im.src = p.img.src.replace(/\/\d+px-/, "/720px-"); }
  document.getElementById("lbName").textContent = p.name;
  document.getElementById("lbYears").textContent = span(p.born, p.died);
  document.getElementById("lbEra").textContent = p.era.name;
  const rd = document.getElementById("lbRead"), page = PAGES[p.name];
  rd.hidden = !page; if (page) rd.href = page; document.getElementById("lbSoon").hidden = !!page;
  lb.inert = false; lb.classList.add("open"); hideTip();
  (page ? rd : document.getElementById("lbClose")).focus();
}
function closeLb() { lb.classList.remove("open"); lb.inert = true; lastFocus && lastFocus.focus(); }
document.getElementById("lbClose").addEventListener("click", closeLb);
lb.addEventListener("click", e => { if (e.target === lb) closeLb(); });
addEventListener("keydown", e => { if (e.key === "Escape" && lb.classList.contains("open")) closeLb(); });

</script>
